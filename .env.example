# Supabase (ver README.md de Reservaste/backend para levantar el proyecto)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usado para armar el redirectTo de OAuth (Google) en local vs. producción.
# En Vercel tiene que ser la URL final con https y SIN barra al final;
# si no coincide con lo que está permitido en Supabase Auth, el login con
# Google falla después de autenticar, que es el peor momento para fallar.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo en Vercel, no en local: token de GitHub con lectura sobre
# Reservaste/backend. @reservaste/domain se instala desde ese repo, que es
# privado, así que sin esto el `npm ci` del build no puede clonarlo.
# Ver "Deploy" en README.md.
# DOMAIN_REPO_TOKEN=

# ADR-0043 (corrección post-review de seguridad, punto 5): Site Key
# (pública) de Cloudflare Turnstile para el widget de captcha en
# /login y /signup -- pareja del secret que backend-engineer ya cargó en
# `[auth.captcha]` de supabase/config.toml. Sin esto, el widget no puede
# renderizarse y el botón de "Ingresar"/"Crear cuenta" queda deshabilitado
# a propósito (nunca se relaja la validación del lado del cliente).
#
# Para desarrollo local, usar SIEMPRE la clave pública de PRUEBA que
# Cloudflare documenta y que siempre pasa (no es secreta, funciona en
# cualquier hostname):
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Producción NECESITA una Site Key real: crear un par Site Key/Secret Key
# gratis en https://dash.cloudflare.com/?to=/:account/turnstile -- el
# Secret Key se carga en el dashboard de Supabase (Authentication > Attack
# Protection), la Site Key acá. No activar [auth.captcha] en el proyecto
# de Supabase de producción hasta que este flujo esté verificado de punta
# a punta contra Supabase local con la clave de prueba (ver docs/decisions.md
# ADR-0043).
