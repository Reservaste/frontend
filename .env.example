# Supabase (ver README.md de Reservaste/backend para levantar el proyecto)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usado para armar el redirectTo de OAuth (Google) en local vs. producción.
# En Vercel tiene que ser la URL final con https y SIN barra al final;
# si no coincide con lo que está permitido en Supabase Auth, el login con
# Google falla después de autenticar, que es el peor momento para fallar.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo en Vercel, no en local: token de GitHub con lectura sobre
# Reservaste/backend. @reservaste/domain se instala desde ese repo, que es
# privado, así que sin esto el `npm ci` del build no puede clonarlo.
# Ver "Deploy" en README.md.
# DOMAIN_REPO_TOKEN=
