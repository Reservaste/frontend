# Runtime-only image: the build already happened outside.
#
# Deploy keys are disabled org-wide on Reservaste, so the droplet has no
# way to fetch @reservaste/domain (private repo) during a build. Building
# where the credentials already live and shipping the artifact sidesteps
# that entirely -- and the droplet ends up holding no git credentials at
# all, which is the better posture anyway.
#
# See deploy/README.md for the build-on-the-droplet variant, once repo
# access is sorted.

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001

COPY public ./public
COPY --chown=nextjs:nodejs .next/standalone ./
COPY --chown=nextjs:nodejs .next/static ./.next/static

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
